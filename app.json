{
  "expo": {
    "name": "TaskPilot AI",
    "slug": "taskpilot-ai",
    "scheme": "taskpilot-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.harsh.taskpilotai",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Allow Techna to listen to your voice to create tasks.",
        "NSSpeechRecognitionUsageDescription": "Allow Techna to recognize your speech to create tasks.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.harsh.taskpilotai",
      "adaptiveIcon": {
        "backgroundColor": "#0D1127",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "RECORD_AUDIO",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "splash": {
      "backgroundColor": "#07070A",
      "resizeMode": "contain"
    },
    "plugins": [
      "expo-font",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Techna to listen to your voice to create tasks."
        }
      ],
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "resizeMode": "contain",
          "backgroundColor": "#07070A"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Techna to listen to your voice to create tasks.",
          "speechRecognitionPermission": "Allow Techna to recognize your speech to create tasks."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "4dc5dd57-4758-4566-a761-4751e9542a17"
      }
    }
  }
}
